{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "16S V1V3/V3V4 amplicon pipeline parameters",
  "type": "object",
  "properties": {
    "test": { "type": "boolean", "default": false, "description": "Run bundled synthetic primer and all-container smoke tests" },
    "fastqc_sif": { "type": ["string", "null"], "description": "Optional local FastQC SIF/IMG; otherwise download BioContainers image" },
    "multiqc_sif": { "type": ["string", "null"], "description": "Optional local MultiQC SIF/IMG; otherwise download BioContainers image" },
    "cutadapt_sif": { "type": ["string", "null"], "description": "Optional local Cutadapt SIF; otherwise download BioContainers image" },
    "qiime_sif": { "type": ["string", "null"], "description": "Optional local QIIME 2 SIF; otherwise download official amplicon image" },
    "region": { "type": "string", "enum": ["V1V3", "V3V4", "v1v3", "v3v4"], "default": "V1V3" },
    "primer_f": { "type": ["string", "null"], "pattern": "^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+$", "description": "Override forward primer (5 prime to 3 prime)" },
    "primer_r": { "type": ["string", "null"], "pattern": "^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+$", "description": "Override reverse primer (5 prime to 3 prime)" },
    "adapter_f": { "type": ["string", "null"], "pattern": "^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+$", "description": "Override forward read-through adapter" },
    "adapter_r": { "type": ["string", "null"], "pattern": "^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+$", "description": "Override reverse read-through adapter" },
    "reads": { "type": "string", "description": "Paired FASTQ glob" },
    "outdir": { "type": "string", "default": "results" },
    "classifier": { "type": "string", "description": "QIIME 2 SILVA classifier artifact" },
    "metadata": { "type": "string", "description": "QIIME 2 metadata TSV" },
    "sampling_depth": { "type": "integer", "default": 1000, "minimum": 1 },
    "alpha_max_depth": { "type": "integer", "default": 10000, "minimum": 1 },
    "diversity_enabled": { "type": "boolean", "default": true },
    "skip_cutadapt": { "type": "boolean", "default": false, "description": "Skip Cutadapt entirely and import original paired reads" },
    "skip_qc": { "type": "boolean", "default": false, "description": "Skip all FastQC and MultiQC tasks" },
    "extra_adapters_f": { "type": "array", "items": { "type": "string", "pattern": "^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+$" }, "default": [], "description": "R1 extra 3-prime adapters in sequenced orientation; list Nextera explicitly" },
    "extra_adapters_r": { "type": "array", "items": { "type": "string", "pattern": "^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+$" }, "default": [], "description": "R2 extra 3-prime adapters in sequenced orientation" },
    "trim_poly_a": { "type": "boolean", "default": false },
    "trim_poly_g": { "type": "boolean", "default": false },
    "poly_min_length": { "type": "integer", "minimum": 1, "default": 10, "description": "Minimum exact consecutive A/G bases at the 3-prime end" },
    "discard_untrimmed": { "type": "boolean", "default": true, "description": "Discard pairs if either mate has no primer/read-through adapter match" },
    "stop_after": { "type": "string", "enum": ["none", "raw_qc", "cutadapt", "clean_qc"], "default": "none" },
    "qc_only": { "type": "boolean", "default": false, "description": "Alias for stop_after clean_qc" },
    "quality": { "type": "integer", "default": 20, "minimum": 0 },
    "min_length": { "type": "integer", "default": 50, "minimum": 1 },
    "dada2_pooling_method": { "type": "string", "enum": ["independent", "pseudo"], "default": "independent" },
    "dada2_trunc_len_f": { "type": "integer", "default": 0, "minimum": 0 },
    "dada2_trunc_len_r": { "type": "integer", "default": 0, "minimum": 0 },
    "benchmark_parameters": { "type": ["string", "null"], "description": "Stage 1 TSV containing config_id, truncation, maxEE and merge settings; M10/M12 use q2-dada2 and CAT is reserved for standalone R/DADA2" },
    "trimm_optimal": { "type": "boolean", "default": false },
    "trimm_combinations": { "type": ["string", "null"], "description": "Custom TSV containing name, trunc_len_f and trunc_len_r; omitted selects params/trimming/<region>_10bp.tsv" },
    "taxonomy_confidence": { "type": "number", "default": 0.7, "minimum": 0, "maximum": 1 },
    "taxonomy_label": { "type": "string", "default": "AUTO", "description": "Classifier/cache label such as SILVA or GG2; AUTO infers it from the classifier path" },
    "optimal_min_sample_reads": { "type": "integer", "default": 10000, "minimum": 0 }
  },
  "if": { "properties": { "test": { "const": true } }, "required": ["test"] },
  "then": {},
  "else": {
    "required": ["reads"],
    "if": {
      "anyOf": [
        { "properties": { "stop_after": { "enum": ["raw_qc", "cutadapt", "clean_qc"] } }, "required": ["stop_after"] },
        { "properties": { "qc_only": { "const": true } }, "required": ["qc_only"] }
      ]
    },
    "then": {},
    "else": {
      "if": { "properties": { "benchmark_parameters": { "type": "string", "minLength": 1 } }, "required": ["benchmark_parameters"] },
      "then": {},
      "else": { "required": ["classifier", "metadata"] }
    }
  }
}
