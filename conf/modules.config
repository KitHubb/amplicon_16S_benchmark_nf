// Pipeline-specific containers, publishing and failure policy.
process {
    withName: 'CUTADAPT' {
        container = { (params.containsKey('cutadapt_sif') ? params.get('cutadapt_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/biocontainers/cutadapt:5.2--py311hc303176_2' : 'docker://quay.io/biocontainers/cutadapt:5.2--py311hc303176_2') }
        publishDir = [path: { "${params.outdir}/02_cutadapt_q20" }, mode: 'copy', overwrite: true]
    }
    withName: 'FASTQC' {
        container = { (params.containsKey('fastqc_sif') ? params.get('fastqc_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' : 'docker://quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0') }
        publishDir = [path: { "${params.outdir}/${stage}/fastqc" }, mode: 'copy', overwrite: true]
    }
    withName: 'MULTIQC' {
        container = { (params.containsKey('multiqc_sif') ? params.get('multiqc_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/biocontainers/multiqc:1.27--pyhdfd78af_0' : 'docker://quay.io/biocontainers/multiqc:1.27--pyhdfd78af_0') }
        publishDir = [path: { "${params.outdir}/${stage}/multiqc" }, mode: 'copy', overwrite: true]
    }
    withName: 'QIIME_DADA2' {
        container = { (params.containsKey('qiime_sif') ? params.get('qiime_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/qiime2/amplicon:2025.7' : 'docker://quay.io/qiime2/amplicon:2025.7') }
        publishDir = [path: { "${params.outdir}/05_dada2" }, mode: 'copy', overwrite: true]
    }
    withName: 'QIIME_DADA2_BENCHMARK' {
        container = { (params.containsKey('qiime_sif') ? params.get('qiime_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/qiime2/amplicon:2025.7' : 'docker://quay.io/qiime2/amplicon:2025.7') }
        publishDir = [path: { "${params.outdir}/${meta.result_dir}" }, mode: 'copy', overwrite: true]
        errorStrategy = 'ignore'
    }
    withName: 'QIIME_IMPORT' {
        container = { (params.containsKey('qiime_sif') ? params.get('qiime_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/qiime2/amplicon:2025.7' : 'docker://quay.io/qiime2/amplicon:2025.7') }
        publishDir = [path: { "${params.outdir}/04_qiime2_import" }, mode: 'copy', overwrite: true]
    }
    withName: 'QIIME_TAXONOMY' {
        container = { (params.containsKey('qiime_sif') ? params.get('qiime_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/qiime2/amplicon:2025.7' : 'docker://quay.io/qiime2/amplicon:2025.7') }
        publishDir = [path: { "${params.outdir}/06_taxonomy" }, mode: 'copy', overwrite: true]
    }
    withName: 'DADA2_TRIMM_SWEEP' {
        container = { (params.containsKey('qiime_sif') ? params.get('qiime_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/qiime2/amplicon:2025.7' : 'docker://quay.io/qiime2/amplicon:2025.7') }
        publishDir = [path: { "${params.outdir}/05_trimm_optimal_dada2" }, mode: 'copy', overwrite: true]
        errorStrategy = 'ignore'
    }
    withName: 'TAXONOMY_TRIMM_SWEEP' {
        container = { (params.containsKey('qiime_sif') ? params.get('qiime_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/qiime2/amplicon:2025.7' : 'docker://quay.io/qiime2/amplicon:2025.7') }
        publishDir = [path: { "${params.outdir}" }, mode: 'copy', overwrite: true,
            saveAs: { filename -> "05_trimm_optimal_${taxonomy_label}/${filename}" }]
        errorStrategy = 'ignore'
    }
    withName: 'SELECT_TRIMM_OPTIMAL' {
        container = { (params.containsKey('qiime_sif') ? params.get('qiime_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/qiime2/amplicon:2025.7' : 'docker://quay.io/qiime2/amplicon:2025.7') }
        publishDir = [path: { "${params.outdir}" }, mode: 'copy', overwrite: true,
            saveAs: { filename -> "05_trimm_optimal_${taxonomy_label}/selected/${filename}" }]
    }
    withName: 'TRIMMING_SUMMARY' {
        container = { (params.containsKey('cutadapt_sif') ? params.get('cutadapt_sif') : null) ?: (workflow.containerEngine == 'docker' ? 'quay.io/biocontainers/cutadapt:5.2--py311hc303176_2' : 'docker://quay.io/biocontainers/cutadapt:5.2--py311hc303176_2') }
        publishDir = [path: { "${params.outdir}/02_cutadapt_q20" }, mode: 'copy', overwrite: true]
    }
}
